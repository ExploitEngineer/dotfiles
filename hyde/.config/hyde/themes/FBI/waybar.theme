$HOME/.config/waybar/theme.css|${scrDir}/wbarconfgen.sh
@define-color bar-bg rgba(4, 8, 15, 0);

@define-color main-bg rgba(8, 15, 29, 0.84);
@define-color main-fg #d2dff2;

@define-color wb-act-bg #3b82f6;
@define-color wb-act-fg #051022;

@define-color wb-hvr-bg #69adf4;
@define-color wb-hvr-fg #051022;
