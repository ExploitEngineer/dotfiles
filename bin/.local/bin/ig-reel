#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
usage: ig-reel [--raw] <file> [speed]

  (default)   9:16 reel: 1080x1920, letterboxed, speed 2x
  --raw, -r   keep original size and speed, just convert to mp4

  speed       playback multiplier, default 2 in reel mode, 1 with --raw
              e.g. 1 = real time, 4 = 4x

examples:
  ig-reel ~/capture/clip.mkv          # 1080x1920 reel at 2x
  ig-reel ~/capture/clip.mkv 1        # 1080x1920 reel at real time
  ig-reel --raw ~/capture/clip.mkv    # same size, real time, just mp4
  ig-reel --raw ~/capture/clip.mkv 2  # same size, 2x
EOF
  exit "${1:-0}"
}

RAW=0
ARGS=()
for a in "$@"; do
  case "$a" in
    -r|--raw) RAW=1 ;;
    -h|--help) usage 0 ;;
    -*) printf 'unknown option: %s\n\n' "$a" >&2; usage 1 ;;
    *) ARGS+=("$a") ;;
  esac
done

[[ ${#ARGS[@]} -ge 1 ]] || usage 1
IN="${ARGS[0]}"
[[ -f "$IN" ]] || { printf 'no such file: %s\n' "$IN" >&2; exit 1; }

mkdir -p "$HOME/ig-ready"
BASE="$(basename "${IN%.*}")"

# In raw mode default to real time; the reel is a highlight clip so it defaults
# to 2x. Either can be overridden by the positional speed argument.
if [[ $RAW -eq 1 ]]; then
  SPEED="${ARGS[1]:-1}"
  OUT="$HOME/ig-ready/$BASE.mp4"
else
  SPEED="${ARGS[1]:-2}"
  OUT="$HOME/ig-ready/$BASE-reel.mp4"
fi

PTS="$(awk "BEGIN{printf \"%.4f\", 1/$SPEED}")"

# wf-recorder captures full-range (color_range=pc) and leaves the colour space
# untagged. Instagram and phone players assume limited-range bt709, so handing
# them untagged full-range video makes blacks crush and highlights clip: the
# washed-out look that made OBS seem sharper by comparison.
#
# in_range=full:out_range=limited does the actual conversion; the -color_* flags
# plus -x264-params tag the result so nothing downstream has to guess. Both modes
# need this, since both end up as yuv420p mp4.
COLOUR="in_range=full:out_range=limited"

if [[ $RAW -eq 1 ]]; then
  # Keep the source resolution. Only two things are forced: yuv420p, because
  # yuv444p in mp4 will not play on most devices, and even dimensions, which
  # x264 requires for 4:2:0 and an arbitrary dragged region will not always have.
  VF="setpts=${PTS}*PTS,scale=trunc(iw/2)*2:trunc(ih/2)*2:${COLOUR},setsar=1,format=yuv420p"
else
  VF="setpts=${PTS}*PTS,scale=1080:1920:force_original_aspect_ratio=decrease:flags=lanczos:${COLOUR},pad=1080:1920:(1080-iw)/2:(1920-ih)/2:0x111111,setsar=1,format=yuv420p"
fi

ffmpeg -nostdin -y -i "$IN" -map_metadata -1 \
  -vf "$VF" \
  -c:v libx264 -crf 16 -preset slow -pix_fmt yuv420p \
  -color_range tv -colorspace bt709 -color_primaries bt709 -color_trc bt709 \
  -x264-params "colorprim=bt709:transfer=bt709:colormatrix=bt709" \
  -movflags +faststart -an "$OUT"

printf '\n→ %s\n' "$OUT"
