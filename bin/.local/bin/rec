#!/usr/bin/env bash
#
# Screen recording via gpu-screen-recorder, framed for a 1080x1920 reel.
#
# Capture width is fixed at 1012 across sharp/wide/mid, so the three cut
# together: all share optical centre 960,558. Only the height varies.
#
# DO NOT "fix" 1012 toward 1080. It is a deliberate choice: nothing is ever
# upscaled, and the clip is placed at native width inside the 1080 reel canvas.
# Widening to 1080 is impossible for sharp anyway, since the usable desktop is
# only 1040 tall once waybar is excluded, and resampling is exactly what ruins
# terminal text.
#
# The region is the terminal's real window frame, read back from the compositor
# after placing it, so the outermost captured pixels are the window border and
# nothing outside it. The drop shadow falls outside the frame and is excluded.
#
# PRESETS
#   rec sharp        1012x1012   square, single terminal (the default)
#   rec wide         1012x556    16:9, a wide panel; a centred band in the reel
#   rec mid          1012x752    4:3, middle ground
#   rec full         1920x1040   whole usable screen
#
#                    full is 1040 tall, not 1080, on purpose: waybar reserves
#                    38px at the top and that is deliberately cropped out, with
#                    2px more lost to even-dimension rounding. Recording the
#                    full 1080 would put the bar in shot.
#
# MULTI-WINDOW
#   rec layout       print how many rows each window gets when 1, 2 or 3 are
#                    stacked in the sharp frame, and what the whole screen looks
#                    like once downscaled into a reel. Prints only, never records.
#
#                    Stack vertically, never side by side: at 1080 output width a
#                    side-by-side pane is ~540px, about 32 columns.
#
# NAMED REGIONS   for framing a specific GUI panel and hitting it again later
#   rec save <name>  drag a region with slurp and store it under <name>
#   rec <name>       record using that saved geometry
#   rec list         show every saved region
#   rec forget <name>  delete one
#
#   For tiled layouts with more than 2 windows, or side-by-side windows, do not
#   capture them together - 1080px output width cannot make them readable.
#   Use `rec save <name>` on each tile separately and cut between the shots.
#
# PREVIEW         check framing without recording
#   rec preview <preset|name>          still to /tmp, opened in a viewer
#   rec preview <preset|name> --keep   still to ~/capture/preview-<name>.png
#
# WINDOW
#   rec win          capture the focused window at its exact bounds
#
# TERMINAL
#   rec fit <preset>  resize the recording terminal to sharp, wide or mid
#                     without recording, so content can be arranged at the final
#                     size first. Recording a preset does this automatically.
#
# CONTROL
#   rec              start the default preset, or stop if already recording
#   rec stop         stop and save
#   rec 30 wide      fps is positional and order-independent
#   rec --help
#
# Recordings land in ~/capture. Saved regions live in ~/.config/rec/regions,
# which is plain text and safe to edit by hand.
#
set -euo pipefail

CAPTURE_DIR="$HOME/capture"
PIDFILE="/tmp/rec.pid"
REGION_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/rec"
REGION_FILE="$REGION_DIR/regions"
# Target CAPTURE REGION sizes. The terminal client is derived from these by
# subtracting the live border, so the region lands on these numbers exactly
# rather than being whatever the window happened to round to.
REGION_W=1012           # see the zoom-budget note in --help
REGION_SHARP_H=1012
REGION_WIDE_H=556
REGION_MID_H=752
CENTRE_X=960            # shared optical centre, so presets can be cut together
CENTRE_Y=558
DEFAULT_PRESET="sharp"
REC_FONT=17            # keep in step with the launcher in keybindings.lua
REC_CELL=30.5          # measured line height at REC_FONT, not a formula
FPS=60

# Every gpu-screen-recorder invocation goes through GSR_FLAGS. Defined readonly
# and in one place so no code path can record without them:
#   -cursor no     the pointer must never appear in a take
#   -k h264        HEVC gets re-encoded or rejected by upload targets
#   -encoder cpu   Pascal NVENC leaves mosquito noise on glyph edges
#   -bm cbr -q     15 Mbps ceiling; static frames stay cheap
#   -cr limited    players assume limited range
readonly GSR_FLAGS=(-k h264 -encoder cpu -bm cbr -q 15000 -cr limited -cursor no)

notify() { command -v notify-send >/dev/null 2>&1 && notify-send "rec" "$1" || echo "$1"; }
warn()   { printf 'rec: warning: %s\n' "$1" >&2; }
die()    { printf 'rec: %s\n' "$1" >&2; notify "$1"; exit 1; }

# ── stop an in-flight recording ─────────────────────────────────────────────
# Only SIGINT makes gpu-screen-recorder finalise the container. SIGTERM or
# SIGKILL leave an unplayable stub, so never use plain kill or pkill here.
stop_recording() {
  local pid; pid="$(cat "$PIDFILE" 2>/dev/null || true)"
  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    kill -INT "$pid"
    rm -f "$PIDFILE"
    notify "stopped"
    return 0
  fi
  rm -f "$PIDFILE"        # stale pidfile from a crashed run
  return 1
}

# ── usable area: the screen minus whatever waybar reserves ──────────────────
# A full-height region on a 1080-tall screen can only start at y=0, which puts
# waybar in shot. Everything below is measured against the usable box instead.
init_geometry() {
  MONITOR="$(gpu-screen-recorder --list-monitors 2>/dev/null | head -1 | cut -d'|' -f1)"
  [[ -n "$MONITOR" ]] || die "no monitor found"
  read -r SW SH < <(gpu-screen-recorder --list-monitors 2>/dev/null | head -1 |
    cut -d'|' -f2 | tr 'x' ' ')
  SW=${SW:-1920}; SH=${SH:-1080}

  read -r RL RT RR RB < <(hyprctl monitors -j 2>/dev/null |
    python3 -c 'import json,sys;r=json.load(sys.stdin)[0]["reserved"];print(*r)' \
    2>/dev/null || echo "0 0 0 0")
  RL=${RL:-0}; RT=${RT:-0}; RR=${RR:-0}; RB=${RB:-0}

  UX=$RL; UY=$RT
  UW=$(( SW - RL - RR )); UH=$(( SH - RT - RB ))
  # The encoder aligns width up to a multiple of 4, so a 1042 request silently
  # became 1044 and captured beyond the frame. Round down instead.
  UW=$(( UW - UW % 4 )); UH=$(( UH - UH % 4 ))
}

# client_for <preset> -> the terminal CLIENT geometry, WxH+X+Y.
#
# This is window placement only. The capture region is read back from the
# compositor afterwards, so the margin/border arithmetic that used to inflate
# every recording by 28px no longer touches the region at all.
#
# All three share optical centre (CENTRE_X, CENTRE_Y) so presets cut together.
border_size() {
  local bs
  bs="$(hyprctl getoption general:border_size -j 2>/dev/null |
    grep -oE '"int": *[0-9]+' | grep -oE '[0-9]+')"
  echo "${bs:-1}"
}

# region_for <preset> -> the target capture region, WxH+X+Y, centred on the
# shared optical centre.
region_for() {
  local w h
  case "$1" in
    sharp) w=$REGION_W; h=$REGION_SHARP_H ;;
    wide)  w=$REGION_W; h=$REGION_WIDE_H  ;;
    mid)   w=$REGION_W; h=$REGION_MID_H   ;;
    *)     return 1 ;;
  esac
  printf '%dx%d+%d+%d' "$w" "$h" \
    $(( CENTRE_X - w / 2 )) $(( CENTRE_Y - h / 2 ))
}

# client_for <preset> -> the terminal client geometry that makes the window
# frame equal the target region: client = region - 2 x border_size.
client_for() {
  local geo w h x y bs; bs="$(border_size)"
  geo="$(region_for "$1")" || return 1
  w="${geo%%x*}"; h="${geo#*x}"; h="${h%%+*}"
  x="${geo#*+}"; y="${x#*+}"; x="${x%%+*}"
  printf '%dx%d+%d+%d' $(( w - 2 * bs )) $(( h - 2 * bs )) \
    $(( x + bs )) $(( y + bs ))
}

# full is the only preset with no terminal involved: it is the usable desktop,
# which deliberately excludes the space waybar reserves.
full_region() { printf '%dx%d+%d+%d' "$UW" "$UH" "$UX" "$UY"; }

is_preset() { case "$1" in sharp|wide|mid|full) return 0 ;; *) return 1 ;; esac; }

# Place the recording terminal so its client area is exactly the preset size,
# centred on the shared optical centre. The capture region is NOT derived from
# this: it is read back from the compositor afterwards by term_region, so the two
# concerns stay separate.
#
# Previously this folded a 12px desktop margin and an assumed 2px border into the
# region itself, which made every capture 28px larger than the terminal and
# included a strip of whatever was behind it. border_size is also theme-dependent
# and is currently 1, so hardcoding it was wrong regardless.
fit_terminal() {
  local w="$1" h="$2" x="$3" y="$4"
  hyprctl eval "
    local t
    for _, c in ipairs(hl.get_windows() or {}) do
      if c.class == 'floatterm' then t = c end
    end
    if t then
      hl.dispatch(hl.dsp.window.resize({window = t, x = $w, y = $h, exact = true}))
      hl.dispatch(hl.dsp.window.move({window = t, x = $x, y = $y, exact = true}))
    end" >/dev/null 2>&1 || true
}

# The capture region: the terminal's real frame, queried from the compositor and
# grown by border_size on each side so the outermost captured pixels are the
# border itself. The drop shadow (decoration:shadow, range 10) falls outside the
# frame and is deliberately excluded.
term_region() {
  local bs
  bs="$(border_size)"
  hyprctl clients -j 2>/dev/null | python3 -c "
import json,sys
bs=int('${bs}')
for c in json.load(sys.stdin):
    if c.get('class')=='floatterm':
        w,h=c['size']; x,y=c['at']
        print('%dx%d+%d+%d'%(w+2*bs, h+2*bs, x-bs, y-bs))
        break
" 2>/dev/null
}

# hyprctl reports a window's TARGET geometry the instant a resize is dispatched,
# not where it currently is on screen, so polling for a stable read returns
# immediately and lands mid-animation. The stability poll below still guards
# against a slow reconfigure, but the animation itself needs a real delay.
#
# The delay is only paid when the geometry actually changed: recording sharp
# twice in a row moves nothing, so there is nothing to wait for.
anim_ms() {
  local sp
  sp="$(hyprctl animations 2>/dev/null |
    awk '/speed:/{ if ($2+0 > m) m = $2+0 } END{ print int(m * 100) }')"
  [[ "${sp:-0}" -gt 0 ]] && echo "$sp" || echo 400
}

wait_for_terminal() {   # $1 = geometry before the resize, may be empty
  local before="${1:-}" cur prev="" stable=0 i
  for i in $(seq 1 40); do
    cur="$(term_region)"
    if [[ -n "$cur" && "$cur" == "$prev" ]]; then
      stable=$(( stable + 1 ))
      (( stable >= 3 )) && break
    else
      stable=0
    fi
    prev="$cur"
    sleep 0.05
  done
  [[ -n "$cur" ]] || return 1
  # Nothing moved, so no animation is in flight.
  [[ "$cur" == "$before" ]] && return 0
  sleep "$(awk "BEGIN{printf \"%.2f\", $(anim_ms) / 1000}")"
  return 0
}

# Place the terminal for a preset, then report the region actually captured.
# Fails if no recording terminal is open, since there would be nothing to frame.
place_and_region() {
  local geo w h x y
  geo="$(client_for "$1")" || return 1
  w="${geo%%x*}"; h="${geo#*x}"; h="${h%%+*}"
  x="${geo#*+}"; y="${x#*+}"; x="${x%%+*}"
  hyprctl clients -j 2>/dev/null | grep -q '"class": "floatterm"' || return 1
  local before; before="$(term_region)"
  fit_terminal "$w" "$h" "$x" "$y"
  wait_for_terminal "$before" || return 1
  term_region
}

# `rec layout` prints how much room each window gets, so a multi-window shot can
# be judged before recording rather than after. It never records.
#
# Stacked windows share the 1040x1040 sharp frame; each loses 2px of border per
# edge plus gaps_in between them. Rows use REC_CELL, the line height measured
# in the real window, minus 2 x window_padding_width.
show_layout() {
  local gi per rows n
  gi="$(hyprctl getoption general:gaps_in -j 2>/dev/null |
    grep -oE '[0-9]+' | head -1)"; gi=${gi:-4}
  echo "stacked vertically inside the 1040x1040 sharp frame, at font ${REC_FONT}:"
  for n in 1 2 3; do
    per=$(( (1040 - 24 - (n * 4) - ((n - 1) * gi)) / n ))
    rows=$(awk "BEGIN{printf \"%d\", ($per - 36) / ${REC_CELL}}")
    printf '  %d window(s): each ~%4dpx tall, 1040 wide -> ~%2d rows\n' "$n" "$per" "$rows"
  done
  echo
  echo "whole screen (rec full, 1920x1040) downscaled into a 1080x1920 reel:"
  echo "  scales 0.562x -> 1080x585, a thin band in the middle of the canvas"
  echo "  a 2x2 tile becomes 540x292 in the reel: ~32 columns, hard to read"
  echo
  echo "for more than 2 windows, or anything side by side, record each tile"
  echo "separately with 'rec save <name>' and cut between the shots."
}

# ── named regions ───────────────────────────────────────────────────────────
region_get() {
  [[ -f "$REGION_FILE" ]] || return 1
  awk -v n="$1" '$1==n {print $2; found=1} END{exit !found}' "$REGION_FILE"
}

region_check() {   # warn about framing problems, never block
  local geo="$1" w h x y
  w="${geo%%x*}"; h="${geo#*x}"; h="${h%%+*}"
  x="${geo#*+}"; y="${x#*+}"; x="${x%%+*}"
  (( w < REGION_W )) && warn "width ${w} is under ${REGION_W}; it will be upscaled and text will soften"
  (( y < UY ))        && warn "region starts at y=${y}, above the usable area (y=${UY}); waybar will be in shot"
  (( w % 4 != 0 ))    && warn "width ${w} is not a multiple of 4; the encoder will round it up"
  return 0
}

open_image() {
  local f="$1" v
  for v in loupe imv swayimg feh eog; do
    if command -v "$v" >/dev/null 2>&1; then "$v" "$f" >/dev/null 2>&1 & return; fi
  done
  xdg-open "$f" >/dev/null 2>&1 &   # last resort; may be a browser
}

# ── subcommands that never record ───────────────────────────────────────────
case "${1:-}" in
  stop)
    stop_recording || notify "not recording"
    exit 0 ;;
  fit)
    # Resize the recording terminal to a preset without recording or previewing,
    # so content can be arranged at the final size first.
    [[ -n "${2:-}" ]] || die "usage: rec fit <sharp|wide|mid>"
    case "$2" in sharp|wide|mid) ;; *) die "fit takes sharp, wide or mid" ;; esac
    init_geometry
    geo="$(place_and_region "$2")" ||
      die "no recording terminal open - press SUPER+CTRL+T first"
    echo "$2: terminal $(client_for "$2")  ->  capture region $geo"
    exit 0 ;;
  layout)
    show_layout
    exit 0 ;;
  list)
    if [[ -s "$REGION_FILE" ]]; then
      printf '  %-18s %s\n' "NAME" "GEOMETRY"
      awk '{printf "  %-18s %s\n", $1, $2}' "$REGION_FILE"
    else
      echo "no saved regions yet - use 'rec save <name>'"
    fi
    exit 0 ;;
  save)
    [[ -n "${2:-}" ]] || die "usage: rec save <name>"
    is_preset "$2" && die "'$2' is a preset name, pick another"
    init_geometry
    geo="$(slurp -d -f '%wx%h+%x+%y')" || { notify "cancelled"; exit 0; }
    [[ -n "$geo" ]] || { notify "cancelled"; exit 0; }
    region_check "$geo"
    mkdir -p "$REGION_DIR"
    touch "$REGION_FILE"
    grep -v "^$2[[:space:]]" "$REGION_FILE" > "$REGION_FILE.tmp" 2>/dev/null || true
    printf '%s\t%s\n' "$2" "$geo" >> "$REGION_FILE.tmp"
    sort -o "$REGION_FILE" "$REGION_FILE.tmp"; rm -f "$REGION_FILE.tmp"
    echo "saved '$2' = $geo"
    notify "saved region '$2'"
    exit 0 ;;
  forget)
    [[ -n "${2:-}" ]] || die "usage: rec forget <name>"
    region_get "$2" >/dev/null || die "no saved region named '$2'"
    grep -v "^$2[[:space:]]" "$REGION_FILE" > "$REGION_FILE.tmp" || true
    mv "$REGION_FILE.tmp" "$REGION_FILE"
    echo "forgot '$2'"
    exit 0 ;;
  preview)
    [[ -n "${2:-}" ]] || die "usage: rec preview <preset|name> [--keep]"
    init_geometry
    target="$2"; keep=0
    [[ "${3:-}" == "--keep" ]] && keep=1
    if [[ "$target" == full ]]; then geo="$(full_region)"
    elif is_preset "$target"; then
      geo="$(place_and_region "$target")" ||
        die "no recording terminal open - press SUPER+CTRL+T first"
    elif geo="$(region_get "$target")"; then :
    else die "unknown preset or saved region: $target"; fi
    if (( keep )); then out="$CAPTURE_DIR/preview-$target.png"; mkdir -p "$CAPTURE_DIR"
    else out="/tmp/rec-preview-$target.png"; fi
    # grim wants "X,Y WxH"; regions are stored as "WxH+X+Y"
    grim_geo="$(sed -E 's/^([0-9]+)x([0-9]+)\+([0-9]+)\+([0-9]+)$/\3,\4 \1x\2/' <<<"$geo")"
    grim -g "$grim_geo" "$out" || die "grim failed for $geo"
    echo "$target = $geo"
    echo "preview -> $out"
    open_image "$out"
    exit 0 ;;
  -h|--help)
    sed -n '3,66p' "$0" | sed 's/^# \{0,1\}//'
    exit 0 ;;
esac

# A bare `rec` while recording is the stop half of the toggle.
if [[ $# -eq 0 ]] && stop_recording; then
  exit 0
fi

# ── parse args, order independent ───────────────────────────────────────────
init_geometry
TARGET=(); WHAT=""
for arg in "$@"; do
  case "$arg" in
    [0-9]*) FPS="$arg" ;;
    win)
      warn "output dimensions follow the focused window, so framing will not be"
      warn "consistent across takes; use a saved named region for a series"
      TARGET=(-w focused); WHAT="focused window" ;;
    *)
      if is_preset "$arg"; then
        if [[ "$arg" == full ]]; then
          geo="$(full_region)"
        else
          geo="$(place_and_region "$arg")" || die "no recording terminal open - press SUPER+CTRL+T first"
        fi
        TARGET=(-w "$geo"); WHAT="$arg $geo"
      elif geo="$(region_get "$arg")"; then
        region_check "$geo"; TARGET=(-w "$geo"); WHAT="$arg $geo"
      else
        die "unknown preset or saved region: $arg   (try 'rec list')"
      fi ;;
  esac
done

if [[ ${#TARGET[@]} -eq 0 ]]; then
  geo="$(place_and_region "$DEFAULT_PRESET")" ||
    die "no recording terminal open - press SUPER+CTRL+T first"
  TARGET=(-w "$geo"); WHAT="$DEFAULT_PRESET $geo"
fi

mkdir -p "$CAPTURE_DIR"
OUT="$CAPTURE_DIR/$(date +%F-%H%M%S).mp4"

# -encoder cpu     x264 rather than this machine's NVENC. The GPU is a Quadro
#                  P1000: Pascal, 6th-gen NVENC, whose weak spot is
#                  high-contrast glyph edges. The mosquito noise it leaves
#                  around terminal text survives the downstream re-encodes.
#                  The Xeon E-2176M holds 60fps here with room to spare.
# -bm cbr -q 15000 x264 reports vbv_maxrate=15000 with filler=0, so this is a
#                  ceiling rather than a floor: static frames stay cheap and a
#                  fast scroll can draw the full rate.
# -k h264          most compatible. Deliberately yuv420p: 4:4:4 is better for
#                  coloured text but High 4:4:4 Predictive has poor mobile
#                  support, and these files go straight to a phone app.
# -cr limited      players assume limited range; full range looks washed out.
gpu-screen-recorder "${TARGET[@]}" -f "$FPS" "${GSR_FLAGS[@]}" \
  -o "$OUT" >/dev/null 2>&1 &

echo $! > "$PIDFILE"
printf 'rec: recording %s @ %sfps -> %s\n' "$WHAT" "$FPS" "$(basename "$OUT")"
