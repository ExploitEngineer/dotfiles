#!/usr/bin/env bash
#
# Screen recording via gpu-screen-recorder.
#
#   rec                 60fps, 1920x1080 (whole screen)
#   rec 30              60 -> 30 fps
#   rec stop            stop and save
#
# Choosing WHICH PART of the screen to record:
#
#   rec pick            drag the area, record it, and remember it
#   rec saved           record that remembered area again
#   rec region          drag the area, record it, do not remember
#   rec 1080x1080+420+0 exact area: WxH+X+Y
#
#   rec sharp pick      drag to POSITION a 1080x1080 box, and remember it
#   rec sharp region    drag to position a 1080x1080 box, do not remember
#   rec 900x900 pick    same, any size
#
# A size on its own is centred on the screen. A size combined with pick/region
# lets you place it: you drag a box with the aspect ratio locked, so you can see
# the framing, and the exact pixel size is snapped around what you dragged.
#
# Size only, always centred on the screen:
#
#   rec 1080x1080       exact size, centred
#   rec sharp           preset: 1080x1080 centred
#   rec tall            preset: 810x1080 centred
#   rec full            whole screen (the default)
#
# Arguments combine in any order, e.g. `rec 30 saved` or `rec sharp 30`.
# Running `rec` again while recording stops it, so one key is a full toggle.
#
set -euo pipefail

CAPTURE_DIR="$HOME/capture"
PIDFILE="/tmp/rec.pid"
REGION_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/rec-region"
FPS=60
SIZE=""          # empty means whole screen
MODE="size"      # size | region

notify() { command -v notify-send >/dev/null 2>&1 && notify-send "rec" "$1" || echo "$1"; }
die() { printf 'rec: %s\n' "$1" >&2; notify "$1"; exit 1; }

# ── stop an in-flight recording ─────────────────────────────────────────────
# Only SIGINT makes gpu-screen-recorder finalise the file. SIGTERM or SIGKILL
# leave an unplayable stub, so never use plain kill or pkill here.
stop_recording() {
  local pid; pid="$(cat "$PIDFILE" 2>/dev/null || true)"
  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    kill -INT "$pid"
    rm -f "$PIDFILE"
    notify "stopped"
    return 0
  fi
  rm -f "$PIDFILE"          # stale pidfile from a crashed run
  return 1
}

if [[ "${1:-}" == "stop" ]]; then
  stop_recording || notify "not recording"
  exit 0
fi

# A bare `rec` while recording acts as the stop half of a toggle.
if [[ $# -eq 0 ]] && stop_recording; then
  exit 0
fi

# ── parse args, order independent ───────────────────────────────────────────
GEOM=""          # explicit WxH+X+Y, wins over SIZE
PRESET=""        # resolved once the usable area is known
for arg in "$@"; do
  case "$arg" in
    [0-9]*x[0-9]*+[0-9]*+[0-9]*) GEOM="$arg"; MODE="geom" ;;
    [0-9]*x[0-9]*)  SIZE="$arg" ;;
    [0-9]*)         FPS="$arg" ;;
    sharp)          PRESET="sharp" ;;
    tall)           PRESET="tall" ;;
    full)           SIZE=""; PRESET="" ;;
    region)         MODE="region" ;;
    pick)           MODE="pick" ;;
    saved|last)     MODE="saved" ;;
    -h|--help)      sed -n '3,32p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)              die "unknown argument: $arg" ;;
  esac
done

mkdir -p "$CAPTURE_DIR"
OUT="$CAPTURE_DIR/$(date +%F-%H%M%S).mp4"

MONITOR="$(gpu-screen-recorder --list-monitors 2>/dev/null | head -1 | cut -d'|' -f1)"
[[ -n "$MONITOR" ]] || die "no monitor found"
read -r SW SH < <(gpu-screen-recorder --list-monitors 2>/dev/null | head -1 |
  cut -d'|' -f2 | tr 'x' ' ')
SW=${SW:-1920}; SH=${SH:-1080}

# Recording must avoid the space waybar reserves, or the bar lands in the shot.
# A 1080-tall region on a 1080-tall screen has nowhere to go but y=0, which is
# exactly why `sharp` was capturing it.
read -r RL RT RR RB < <(hyprctl monitors -j 2>/dev/null |
  python3 -c 'import json,sys;r=json.load(sys.stdin)[0]["reserved"];print(*r)' 2>/dev/null || echo "0 0 0 0")
RL=${RL:-0}; RT=${RT:-0}; RR=${RR:-0}; RB=${RB:-0}
UX=$RL; UY=$RT
UW=$(( SW - RL - RR )); UH=$(( SH - RT - RB ))

# Round to a multiple of 4: the encoder aligns width up otherwise, so a 1042
# request silently came out 1044 and captured 2px more than the frame.
case "$PRESET" in
  sharp) SIDE=$(( UH < 1080 ? UH : 1080 )); SIDE=$(( SIDE - SIDE % 4 )); SIZE="${SIDE}x${SIDE}" ;;
  tall)  SIZE="$(( 810 - 810 % 4 ))x$(( UH - UH % 4 ))" ;;
esac

# ── work out what to capture ────────────────────────────────────────────────
# `sharp` and a bare WxH give an exact size but always centre it. To pin down a
# *specific part* of the screen and reuse it across takes, use `pick` once and
# `saved` thereafter, or pass the full geometry yourself.
TARGET=()
if [[ "$MODE" == "pick" || "$MODE" == "region" ]]; then
  # slurp exits non-zero when cancelled with Esc; without this guard `set -e`
  # would kill the script before any notification.
  if [[ -n "$SIZE" ]]; then
    # A size combined with pick/region means "this exact size, but let me choose
    # where". You drag a box with the aspect ratio locked to the requested size,
    # so you can see and position it, and the exact pixel size is then snapped
    # around the centre of whatever you dragged. Dragging alone cannot land on an
    # exact size, and a bare click (slurp -p) gives no preview of where the box
    # would end up, so this is the compromise that shows you the frame.
    W="${SIZE%x*}"; H="${SIZE#*x}"
    (( W > UW )) && W=$UW
    (( H > UH )) && H=$UH
    W=$(( W - W % 4 )); H=$(( H - H % 4 ))

    SEL="$(slurp -d -a "${W}:${H}" -f '%w %h %x %y')" || { notify "cancelled"; exit 0; }
    [[ -n "$SEL" ]] || { notify "cancelled"; exit 0; }
    read -r DW DH DX DY <<<"$SEL"

    # centre the exact-size box on the centre of the dragged one, then clamp
    X=$(( DX + DW / 2 - W / 2 )); Y=$(( DY + DH / 2 - H / 2 ))
    (( X < UX )) && X=$UX
    (( Y < UY )) && Y=$UY
    (( X + W > UX + UW )) && X=$(( UX + UW - W ))
    (( Y + H > UY + UH )) && Y=$(( UY + UH - H ))
    GEO="${W}x${H}+${X}+${Y}"
  else
    # -d shows the live dimensions while dragging, so you can hit a size by eye.
    GEO="$(slurp -d -f '%wx%h+%x+%y')" || { notify "cancelled"; exit 0; }
    [[ -n "$GEO" ]] || { notify "cancelled"; exit 0; }
  fi
  if [[ "$MODE" == "pick" ]]; then
    mkdir -p "$(dirname "$REGION_FILE")"
    printf '%s\n' "$GEO" > "$REGION_FILE"
    notify "region saved: $GEO"
  fi
  TARGET=(-w "$GEO")
elif [[ "$MODE" == "saved" ]]; then
  GEO="$(cat "$REGION_FILE" 2>/dev/null || true)"
  [[ -n "$GEO" ]] || die "no saved region yet - run 'rec pick' first"
  TARGET=(-w "$GEO")
elif [[ "$MODE" == "geom" ]]; then
  TARGET=(-w "$GEOM")
elif [[ -n "$SIZE" && "$SIZE" != "${SW}x${SH}" ]]; then
  W="${SIZE%x*}"; H="${SIZE#*x}"
  (( W > UW )) && W=$UW
  (( H > UH )) && H=$UH
  W=$(( W - W % 4 )); H=$(( H - H % 4 ))     # encoder aligns width to 4
  TARGET=(-w "${W}x${H}+$(( UX + (UW - W) / 2 ))+$(( UY + (UH - H) / 2 ))")
else
  TARGET=(-w "$MONITOR")                      # whole screen, no region maths
fi

# -encoder cpu     x264 rather than this machine's NVENC. The GPU is a Quadro
#                  P1000: Pascal, 6th-gen NVENC, whose documented weak spot is
#                  high-contrast glyph edges. The mosquito noise it puts around
#                  terminal text survives the downstream re-encodes and shows up
#                  in the final upload. The Xeon E-2176M (6c/12t) is nowhere near
#                  loaded by 1042x1042 of near-static terminal.
# -bm cbr -q 15000 constant 15 Mbps. QP mode was not wrong, but this file is a
#                  master, not a deliverable: ~56MB for 30s costs nothing and
#                  guarantees the one high-complexity moment, a fast scroll, is
#                  not starved of bits. 25 Mbps is past transparent for this
#                  content.
# -k h264          most compatible; HEVC gets re-encoded or rejected by uploads.
#                  Deliberately staying yuv420p: 4:4:4 is genuinely better for
#                  coloured text, but High 4:4:4 Predictive has poor mobile
#                  support and this file goes straight to a phone app.
# -cr limited      players assume limited range; full range looks washed out
# -cursor no       keeps the pointer out of the frame
gpu-screen-recorder "${TARGET[@]}" \
  -f "$FPS" -k h264 -encoder cpu -bm cbr -q 15000 -cr limited -cursor no \
  -o "$OUT" >/dev/null 2>&1 &

echo $! > "$PIDFILE"

# Report the area actually being captured, not just the requested size.
case "$MODE" in
  pick|region|saved) WHAT="$GEO" ;;
  geom)              WHAT="$GEOM" ;;
  *)                 WHAT="${SIZE:-${SW}x${SH}}" ;;
esac
notify "recording $WHAT @ ${FPS}fps → $(basename "$OUT")"
