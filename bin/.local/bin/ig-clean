#!/usr/bin/env bash
set -euo pipefail
OUT="$HOME/ig-ready"
mkdir -p "$OUT"

KEEP='filename|directory|filesize|filemodify|fileaccess|fileinode|filepermissions|filetype|filetypeext|mimetype|imagewidth|imageheight|bitspersample|colorcomponents|encodingprocess|ycbcr|megapixels|imagesize|exiftoolversion'

for f in "$@"; do
  [[ -f "$f" ]] || { printf 'skip: %s\n' "$f" >&2; continue; }
  base="$(basename "$f")"
  cp -- "$f" "$OUT/$base"
  exiftool -all= -overwrite_original -- "$OUT/$base" >/dev/null
  printf '\n=== %s ===\n' "$OUT/$base"
  leftover="$(exiftool -s -- "$OUT/$base" | grep -viE "$KEEP" || true)"
  [[ -n "$leftover" ]] && printf 'REMAINING:\n%s\n' "$leftover" || printf 'clean\n'
done
